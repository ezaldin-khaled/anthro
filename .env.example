# Used by docker-compose.prod.yml for published ports (copy to .env on the server).
# Defaults are safe on a shared VPS so `docker compose up` does not grab host :80.

ANTHRO_HTTP_PORT=9080
ANTHRO_HTTPS_PORT=9443

# Dedicated machine with only Anthro on public HTTP/S:
# ANTHRO_HTTP_PORT=80
# ANTHRO_HTTPS_PORT=443
