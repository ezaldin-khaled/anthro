# Production — copy to repo root as `.env` (same folder as docker-compose.prod.yml).
# Docker Compose loads this automatically; do not commit `.env`.
#
# Deploys should use `./scripts/deploy-up.sh -d --build` or `./start-shared.sh --build`.
# If Docker network `edge` exists (Traefik on this VPS), `docker-compose.traefik.yml` is merged automatically.

# --- Backend (Go): contact form SMTP + admin JWT ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@anthrotech.ae
SMTP_PASS=your-mailbox-password
# Where form submissions are delivered (defaults to SMTP_USER if unset)
CONTACT_TO=hello@anthrotech.ae

ADMIN_EMAIL=admin@anthrotech.ae
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=generate-with-openssl-rand-base64-32

# --- Published ports (shared VPS; defaults match docker-compose.prod.yml) ---
ANTHRO_HTTP_PORT=9080
ANTHRO_HTTPS_PORT=9443

# --- Optional: Traefik merge (docker-compose.prod.yml + docker-compose.traefik.yml) ---
# TRAEFIK_NETWORK=edge
# TRAEFIK_DOCKER_NETWORK=edge
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
