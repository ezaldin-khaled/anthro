# When behind a main proxy (shared droplet): host nginx terminates TLS and forwards to this container (e.g. :9080→:80).
# Listen on :80 without filtering by hostname so every proxied request reaches Nginx (SPA fallback).
# Strict host-only matching caused HTTP 404 when Host did not match anthrotech.ae exactly.

:80 {
  reverse_proxy frontend:80 {
    header_up Host {host}
    header_up X-Forwarded-Proto https
  }
}
